# 学习以来注入

from fastapi import Depends, FastAPI, HTTPException, Header
from jwt.utils import raw_to_der_signature

app = FastAPI()

def common_params(q: str | None, skip: int = 0, limit: int = 100):
    return {"q": q, "skip": skip, "limit": limit}

@app.get("/items/")
async def read_items(params: dict = Depends(common_params)):
    return params

# 使用yield进行资源管理（重要！！）

# 类作为依赖项

class TokenChecker:
    def __init__(self, x_token: str = Header(...)):
        if x_token != "secret-token":
            raise HTTPException(status_code=400, detail="X-Token header invalid")
        self.token = x_token

@app.get("/items/secure", dependencies=[Depends(TokenChecker)])
async def read_secure_items():
    # 这里不需要接收 TokenChecker 实例，dependencies 参数只负责执行检查
    # 如果检查失败，上面已经抛出了异常，代码不会运行到这里
    return {"data": "secure data"}

# 如果需要拿到实例中的数据：
@app.get("/items/secure-with-data")
async def read_security_items_data(checker: TokenChecker = Depends(TokenChecker)):
    return {"token_used": checker.token}