# ==============================================================================
# YanZhuShou Application Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://api:api@localhost:5432/fastapi_db

# ------------------------------------------------------------------------------
# JWT Authentication
# IMPORTANT: Change SECRET_KEY in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ------------------------------------------------------------------------------
# Feedback System Configuration
# ------------------------------------------------------------------------------
FEEDBACK_VOTE_THRESHOLD=10
FEEDBACK_NOTIFICATION_ENABLED=true
FEEDBACK_NOTIFICATION_EMAIL=dev@example.com
FEEDBACK_NOTIFICATION_WEBHOOK_URL=
FEEDBACK_SUBMISSION_LIMIT_HOURS=24

# ------------------------------------------------------------------------------
# CORS Configuration (optional, defaults are in main.py)
# Add your frontend URL here for production
# ------------------------------------------------------------------------------
# FRONTEND_URL=http://localhost:5173

# For development: Allow all origins (convenient for local network access)
# Set to "true" to allow all origins during development
# WARNING: Do not use in production!
ALLOW_ALL_ORIGINS=true

# ------------------------------------------------------------------------------
# AI Analysis Configuration (new)
# ------------------------------------------------------------------------------
# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_BASE_URL=https://api.openai.com/v1

# AI Analysis Settings
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3
AI_CACHE_TTL=3600

# Feature Flags
AI_ANALYSIS_ENABLED=true
AI_ASYNC_PROCESSING=true

# Book Upload Settings
MAX_BOOK_FILE_SIZE=52428800
ALLOWED_BOOK_TYPES=pdf,md,markdown,docx
