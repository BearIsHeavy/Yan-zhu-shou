# ==============================================================================
# YanZhuShou Application Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# For Docker: use 'postgres' as hostname (Docker service name)
# For local dev: use 'localhost'
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://api:api@postgres:5432/fastapi_db

# ------------------------------------------------------------------------------
# JWT Authentication
# IMPORTANT: Change SECRET_KEY in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Redis Configuration
# For Docker: use 'redis' as hostname (Docker service name)
# For local dev: use 'localhost'
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# ------------------------------------------------------------------------------
# Feedback System Configuration
# ------------------------------------------------------------------------------
FEEDBACK_VOTE_THRESHOLD=10
FEEDBACK_NOTIFICATION_ENABLED=true
FEEDBACK_NOTIFICATION_EMAIL=dev@example.com
FEEDBACK_NOTIFICATION_WEBHOOK_URL=
FEEDBACK_SUBMISSION_LIMIT_HOURS=24

# ------------------------------------------------------------------------------
# CORS Configuration (optional, defaults are in main.py)
# Add your frontend URL here for production
# ------------------------------------------------------------------------------
# FRONTEND_URL=http://localhost:5173
