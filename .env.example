# ============================================================
# YanZhuShou Server - Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# -----------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fastapi_db

# -----------------------------------------------------------
# Redis (for caching)
# -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# -----------------------------------------------------------
# Authentication
# -----------------------------------------------------------
# Generate a secure key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
# Set to "true" for development to allow all origins (NOT for production)
ALLOW_ALL_ORIGINS=false

# -----------------------------------------------------------
# AI Analysis (Ollama / OpenAI-compatible API)
# -----------------------------------------------------------
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=ollama
AI_ANALYSIS_ENABLED=true
AI_ASYNC_PROCESSING=true
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3
AI_CACHE_TTL=3600

# -----------------------------------------------------------
# RAG (Retrieval-Augmented Generation)
# -----------------------------------------------------------
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_VECTOR_STORE=pgvector
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_SEARCH_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_TOKENS=4000

# -----------------------------------------------------------
# Logging
# -----------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
